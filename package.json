{
  "name": "auralis-cards",
  "version": "0.13.9",
  "description": "Auralis Frame cards for rooms, covers, lights, thermostats, connected fridges and machines in Home Assistant.",
  "type": "module",
  "main": "dist/auralis-cards.js",
  "files": [
    "dist/auralis-cards.js",
    "README.md",
    "hacs.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-legacy-bundle.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "verify": "npm run check && npm run test && npm run build"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "custom-card",
    "unraid",
    "navigation"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
